# Copia a .env.local para desarrollo. En producción se cargan en Vercel → Settings → Environment Variables.
# Nunca subas valores reales al repositorio.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # clave secreta sb_secret_… (solo servidor)

# --- Acceso ---
ALLOWED_EMAILS=                 # correos que pueden entrar, separados por coma
NEXT_PUBLIC_SITE_URL=           # dominio de producción, sin barra final

# --- Sincronización ---
SYNC_SECRET=                    # secreto largo al azar; el mismo va al Vault de Supabase

# --- Meta Ads (Business Manager → Usuarios del sistema → Generar token, permiso ads_read) ---
META_ACCESS_TOKEN=
META_API_VERSION=v25.0

# --- TikTok for Business (business-api.tiktok.com → My Apps) ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# --- Gateways (solo los que uses) ---
DIGISTORE24_IPN_PASSPHRASE=     # frase-senha del IPN
HOTMART_HOTTOK=                 # hottok del webhook
KIWIFY_WEBHOOK_TOKEN=           # token del webhook
STRIPE_WEBHOOK_SECRET=          # whsec_…
CLICKBANK_SECRET_KEY=           # Secret Key de la cuenta
WEBHOOK_SECRET=                 # para el webhook genérico (?key=)
