# Copia a .env.local para desarrollo. En producción se cargan en Vercel → Settings → Environment Variables.
# Nunca subas valores reales al repositorio.

# Supabase → Project Settings → API (o "Connect"): Project URL y Publishable key (antes "anon key").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Correos que pueden entrar al panel, separados por coma.
ALLOWED_EMAILS=

# Dominio de producción, sin barra final. Ej: https://tracker.tudominio.com
NEXT_PUBLIC_SITE_URL=
